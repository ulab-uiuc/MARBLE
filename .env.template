# Copy this file to `.env` and fill in the keys of the providers you use.
# Models are called through LiteLLM, so only the provider you pick needs a key.

# OpenAI (e.g. --model gpt-4o-mini)
OPENAI_API_KEY="sk-xxxxx"

# Together AI (e.g. --model together_ai/meta-llama/Llama-3.3-70B-Instruct-Turbo)
TOGETHERAI_API_KEY="xxxxx"

# OpenRouter (e.g. --model openrouter/google/gemini-2.5-flash)
# OPENROUTER_API_KEY="sk-or-xxxxx"

# Google AI Studio (e.g. --model gemini/gemini-2.5-flash)
# GEMINI_API_KEY="xxxxx"
